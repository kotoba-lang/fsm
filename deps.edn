;; kotoba-lang/fsm — kami.fsm SSoT (EDN state machines). Pure .cljc.
;; ADR-2607102200 addendum 7.
{:paths ["src"]
 :deps {org.clojure/clojure {:mvn/version "1.11.1"}
        org.clojure/clojurescript {:mvn/version "1.11.132"}}
 :aliases
 {:test {:extra-paths ["test"]
         ;; The Kotoba compiler is a TEST-ONLY dependency: it lives in :test
         ;; and nowhere in :deps, so it cannot change what this library does.
         ;; It exists purely so the parity gate can compile the `.kotoba`
         ;; profile in-process and diff it against the `.cljc` oracle.
         ;;
         ;; The SHA is the compiler commit this repo already ships against,
         ;; recorded in migration/player-fsm-v1.edn :verification/:compiler-commit
         ;; (release v0.6.29, the same release .github/workflows/ci.yml
         ;; downloads). Keep the three in step: bumping one without the others
         ;; makes the gate measure a compiler the repo does not ship.
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                      io.github.kotoba-lang/compiler
                      {:git/sha "94f29b24cdf5c5aa92b35cf2dd41c1d56b8205c1"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test" "--fail-level" "error"]}}}
